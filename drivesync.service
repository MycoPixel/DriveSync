[Unit]
Description=DriveSync — Google Drive sync client (background worker + dashboard)
After=network-online.target

[Service]
# Type=notify + the watchdog: the worker sends READY=1 on startup and pings
# WATCHDOG=1 while the pass loop, the idle wait or a transfer chunk shows
# liveness. A hung worker stops pinging and systemd restarts it instead of
# leaving sync silently stalled. Slow-but-moving transfers are safe: the
# heartbeat is fed from the upload/download chunk loops.
Type=notify
WatchdogSec=180
ExecStart=__VENV__/bin/python -m drivesync serve
Restart=on-failure
RestartSec=10

# Sandboxing. The worker only needs the user's home (sync folders, config,
# SQLite DB) and outbound HTTPS to Google, so keep everything else out of
# reach. ProtectHome must stay off: syncing files under ~ is the whole job.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=off
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
TimeoutStopSec=30

[Install]
WantedBy=default.target
